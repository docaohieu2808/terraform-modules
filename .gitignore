# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform working directories
**/.terraform/
# .terraform.lock.hcl IS committed (reproducible provider versions)

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan files — include both extension-less and extensioned variants
tfplan
*.tfplan
*.plan

# Backup files
*.bak
*.backup

# Terragrunt cache
**/.terragrunt-cache/

# Generated by Terragrunt (root.hcl) at run time
backend.tf
provider_generated.tf

# Output of the local-only learning levels
**/out/

# Service account credentials
*.json
!example-*.json

# Environment-specific overrides
*.override.tf
*.override.tf.json
override.tf
override.tf.json

# Sensitive variable files
secrets.auto.tfvars
secrets.tfvars

# OS files
.DS_Store
Thumbs.db

# Editor files
.idea/
.vscode/
*.swp
*.swo
*~
